includes:
    - vendor/cambis/silverstan/extension.neon

parameters:
    level: 5
    paths:
        - src
    # These integrate with silvershop/invoicing, a suggested (not required) dependency that isn't
    # installed in CI, so its ShopInvoice/ShopInvoiceLine types can't be resolved here. They are covered
    # by integration tests when invoicing is present.
    excludePaths:
        - src/Extension/InvoiceVatExtension.php
        - src/Report/VatByRateReport.php
    treatPhpDocTypesAsCertain: false
    silverstan:
        includeTestOnly: true
