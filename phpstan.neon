includes:
    - vendor/cambis/silverstan/extension.neon

parameters:
    level: 5
    paths:
        - src
    # InvoiceVatExtension integrates with silvershop/invoicing, a suggested (not required) dependency that
    # isn't installed in CI, so its ShopInvoice types can't be resolved here. It is covered by integration
    # tests when invoicing is present.
    excludePaths:
        - src/Extension/InvoiceVatExtension.php
    treatPhpDocTypesAsCertain: false
    silverstan:
        includeTestOnly: true
